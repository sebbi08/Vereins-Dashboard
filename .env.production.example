# ─── Container Image ────────────────────────────────────────────────────────
# Set automatically by the deploy workflow. Override manually for testing.
IMAGE_NAME=ghcr.io/CHANGE_ME/mv-dashboard:latest

# ─── Network ─────────────────────────────────────────────────────────────────
# Port on the host machine that the app is reachable on.
# If you put a reverse proxy (Caddy/Nginx) in front, set this to 127.0.0.1:3000
# to avoid exposing the port publicly.
APP_PORT=3000

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
DATABASE_URL=file:/app/data/db.sqlite
DATA_DIR=/app/data
