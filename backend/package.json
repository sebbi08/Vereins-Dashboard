{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "prisma generate && prisma migrate deploy && tsx watch src/index.ts",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "build": "npx prisma generate && tsc -p tsconfig.json",
    "start": "prisma generate && node dist/backend/src/index.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.11.1",
    "docxtemplater": "^3.71.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "n2words": "^6.3.0",
    "nodemailer": "^10.3.1",
    "pdf-lib": "^1.17.1",
    "pizzip": "^3.3.0",
    "prisma": "^7.10.1"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
