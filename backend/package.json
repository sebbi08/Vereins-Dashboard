{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "prisma generate && prisma migrate deploy && tsx watch src/index.ts",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "build": "npx prisma generate && tsc -p tsconfig.json",
    "start": "prisma generate && node dist/backend/src/index.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.9.0",
    "docxtemplater": "^3.71.0",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "n2words": "^6.3.0",
    "nodemailer": "^10.0.16",
    "pdf-lib": "^1.17.1",
    "pizzip": "^3.2.0",
    "prisma": "^7.10.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.5",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.5"
  }
}
