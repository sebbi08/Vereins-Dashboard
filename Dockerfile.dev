FROM node:22-alpine

# Install LibreOffice for DOCX → PDF conversion
RUN apk add --no-cache libreoffice ttf-freefont

WORKDIR /app

# Copy package files for all workspaces
COPY package*.json ./
COPY frontend/package*.json ./frontend/
COPY backend/package*.json ./backend/
COPY shared/package*.json ./shared/

RUN npm ci

# Prisma generate (schema is mounted at runtime via volume,
# but we need the initial generate for the client types)
COPY backend/prisma ./backend/prisma
RUN cd backend && npx prisma generate

# Source code is mounted as volumes at runtime
# Ports: 3000 = backend, 5173 = frontend (Vite)
EXPOSE 3000 5173
