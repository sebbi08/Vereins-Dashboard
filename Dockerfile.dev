# Dev image — provides OS-level dependencies only.
# Project code and node_modules are bind-mounted at runtime.
FROM node:22-slim

# Liberation and Carlito are metric-compatible with Arial/Times/Courier and Calibri, the fonts
# the templates use; the production image installs the same families.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libreoffice \
        fonts-liberation \
        fonts-crosextra-carlito \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

CMD ["sleep", "infinity"]
